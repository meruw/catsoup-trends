{
  "openapi": "3.1.0",
  "info": {
    "title": "CATsoup Trends local API",
    "version": "0.1.0-poc",
    "description": "Single-user loopback API. All requests require a per-process session credential. Host and Origin are restricted to the actual listener. No public hosting or Publisher client is implemented. JSON bodies are limited to 32 KiB."
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "security": [
    {
      "localSession": []
    }
  ],
  "paths": {
    "/status": {
      "get": {
        "summary": "Read configuration status; never returns the key",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            }
          },
          "default": {
            "description": "Controlled error; HTTP 400/401/403/404/408/409/415/429/500/502/503 as applicable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/settings/youtube": {
      "put": {
        "summary": "Save a Windows-protected API key; does not validate Google access",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "key": {
                    "type": "string",
                    "minLength": 20,
                    "maxLength": 128
                  }
                },
                "required": [
                  "key"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OK"
                }
              }
            }
          },
          "default": {
            "description": "Controlled error; HTTP 400/401/403/404/408/409/415/429/500/502/503 as applicable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Remove a saved API key; environment keys are read-only",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OK"
                }
              }
            }
          },
          "default": {
            "description": "Controlled error; HTTP 400/401/403/404/408/409/415/429/500/502/503 as applicable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/search": {
      "get": {
        "summary": "Search YouTube; up to 20 videos per page",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "description": "Maximum 200 UTF-8 bytes after trimming.",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          {
            "name": "order",
            "in": "query",
            "required": false,
            "description": "",
            "schema": {
              "type": "string",
              "enum": [
                "relevance",
                "viewCount",
                "date"
              ],
              "default": "relevance"
            }
          },
          {
            "name": "duration",
            "in": "query",
            "required": false,
            "description": "short means under four minutes, not confirmed Shorts.",
            "schema": {
              "type": "string",
              "enum": [
                "short",
                "any"
              ],
              "default": "short"
            }
          },
          {
            "name": "period",
            "in": "query",
            "required": false,
            "description": "",
            "schema": {
              "type": "string",
              "enum": [
                "any",
                "7",
                "30",
                "90"
              ],
              "default": "any"
            }
          },
          {
            "name": "language",
            "in": "query",
            "required": false,
            "description": "Relevance preference only.",
            "schema": {
              "type": "string",
              "enum": [
                "",
                "es",
                "en"
              ],
              "default": ""
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Opaque nextPage token; keep the other query parameters unchanged.",
            "schema": {
              "type": "string",
              "maxLength": 512
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchPage"
                }
              }
            }
          },
          "default": {
            "description": "Controlled error; HTTP 400/401/403/404/408/409/415/429/500/502/503 as applicable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/references": {
      "get": {
        "summary": "List saved references, 20 per page",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Search current metadata, notes, analysis, and video ID; maximum 200 UTF-8 bytes.",
            "schema": {
              "type": "string",
              "maxLength": 200
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "description": "",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000,
              "default": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SavedPage"
                }
              }
            }
          },
          "default": {
            "description": "Controlled error; HTTP 400/401/403/404/408/409/415/429/500/502/503 as applicable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Save a video from a recent search; preserves existing notes and analysis",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_-]{11}$"
                  }
                },
                "required": [
                  "id"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OK"
                }
              }
            }
          },
          "default": {
            "description": "Controlled error; HTTP 400/401/403/404/408/409/415/429/500/502/503 as applicable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/references/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{11}$"
          }
        }
      ],
      "get": {
        "summary": "Read a saved reference",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Reference"
                }
              }
            }
          },
          "default": {
            "description": "Controlled error; HTTP 400/401/403/404/408/409/415/429/500/502/503 as applicable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "patch": {
        "summary": "Replace creator notes and analysis; omitted fields become empty",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "note": {
                    "type": "string",
                    "maxLength": 1000
                  },
                  "analysis": {
                    "$ref": "#/components/schemas/Analysis"
                  }
                },
                "required": [
                  "note",
                  "analysis"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OK"
                }
              }
            }
          },
          "default": {
            "description": "Controlled error; HTTP 400/401/403/404/408/409/415/429/500/502/503 as applicable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Delete reference and creator notes; idempotent",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OK"
                }
              }
            }
          },
          "default": {
            "description": "Controlled error; HTTP 400/401/403/404/408/409/415/429/500/502/503 as applicable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/references/{id}/refresh": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{11}$"
          }
        }
      ],
      "post": {
        "summary": "Refresh current YouTube metadata; unavailable videos return 404 and lose cached metadata",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Video"
                }
              }
            }
          },
          "default": {
            "description": "Controlled error; HTTP 400/401/403/404/408/409/415/429/500/502/503 as applicable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/exports/claude": {
      "post": {
        "summary": "Export creator observations and source links; no upload to Claude",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "ids": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_-]{11}$"
                    },
                    "minItems": 1,
                    "maxItems": 10,
                    "uniqueItems": true
                  }
                },
                "required": [
                  "ids"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "markdown": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "markdown"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "default": {
            "description": "Controlled error; HTTP 400/401/403/404/408/409/415/429/500/502/503 as applicable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/shutdown": {
      "post": {
        "summary": "Stop this local server",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OK"
                }
              }
            }
          },
          "default": {
            "description": "Controlled error; HTTP 400/401/403/404/408/409/415/429/500/502/503 as applicable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "localSession": {
        "type": "http",
        "scheme": "bearer",
        "description": "Random local launch credential; expires on process shutdown."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "additionalProperties": false
      },
      "OK": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          }
        },
        "required": [
          "ok"
        ],
        "additionalProperties": false
      },
      "Video": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{11}$"
          },
          "title": {
            "type": "string"
          },
          "channel": {
            "type": "string"
          },
          "channelId": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "thumbnail": {
            "type": "string"
          },
          "publishedAt": {
            "type": "string",
            "format": "date-time"
          },
          "observedAt": {
            "type": "string",
            "format": "date-time"
          },
          "duration": {
            "type": "string"
          },
          "views": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "likes": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "comments": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          }
        },
        "required": [
          "id",
          "title",
          "channel",
          "channelId",
          "description",
          "thumbnail",
          "publishedAt",
          "observedAt",
          "duration",
          "views",
          "likes",
          "comments"
        ],
        "additionalProperties": false
      },
      "Analysis": {
        "type": "object",
        "properties": {
          "hook": {
            "type": "string",
            "maxLength": 1000
          },
          "structure": {
            "type": "string",
            "maxLength": 1000
          },
          "twist": {
            "type": "string",
            "maxLength": 1000
          },
          "adaptation": {
            "type": "string",
            "maxLength": 1000
          },
          "keywords": {
            "type": "string",
            "maxLength": 500
          }
        },
        "required": [
          "hook",
          "structure",
          "twist",
          "adaptation",
          "keywords"
        ],
        "additionalProperties": false
      },
      "Reference": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{11}$"
          },
          "video": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Video"
              },
              {
                "type": "null"
              }
            ]
          },
          "note": {
            "type": "string"
          },
          "analysis": {
            "$ref": "#/components/schemas/Analysis"
          },
          "savedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "video",
          "note",
          "analysis",
          "savedAt"
        ],
        "additionalProperties": false
      },
      "Status": {
        "type": "object",
        "properties": {
          "keyConfigured": {
            "type": "boolean"
          },
          "keyVerified": {
            "type": "boolean"
          },
          "keySource": {
            "type": "string",
            "enum": [
              "none",
              "protected",
              "environment"
            ]
          },
          "canStoreKey": {
            "type": "boolean"
          },
          "version": {
            "type": "string"
          }
        },
        "required": [
          "keyConfigured",
          "keyVerified",
          "keySource",
          "canStoreKey",
          "version"
        ],
        "additionalProperties": false
      },
      "SearchPage": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Video"
            }
          },
          "nextPage": {
            "type": "string"
          },
          "savedIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{11}$"
            }
          },
          "cached": {
            "type": "boolean"
          }
        },
        "required": [
          "items",
          "nextPage",
          "savedIds",
          "cached"
        ],
        "additionalProperties": false
      },
      "SavedPage": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Reference"
            }
          },
          "total": {
            "type": "integer",
            "minimum": 0
          },
          "hasMore": {
            "type": "boolean"
          }
        },
        "required": [
          "items",
          "total",
          "hasMore"
        ],
        "additionalProperties": false
      }
    }
  }
}
