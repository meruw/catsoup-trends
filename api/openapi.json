      },
      "delete": {
        "summary": "Delete only this format; keep references",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OK"
                }
              }
            }
          },
          "default": {
            "description": "Controlled error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
